# Configuración del Entorno - Agenda Inteligente

# Servidor Backend Local
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Carpeta segura de documentos (Ruta absoluta o relativa a la raíz)
MANAGED_DOCS_PATH=./managed_documents

# Base de datos local
DATABASE_URL=sqlite:///./agenda.db

# Configuración opcional de IA (Gemini / OpenAI u otros modelos para lenguaje natural)
# GEMINI_API_KEY=tu_api_key_aqui
